# Public configuration only. Vite inlines every VITE_* value into the browser bundle: never put a secret here.
# The API origin, without a path (the app adds /api/... itself).
VITE_API_URL=http://localhost:5000
# The deployed CredentialRegistry (printed by `npx hardhat run scripts/deploy.js` in blockchain/) and its chain id.
# Without these the app can verify documents but cannot anchor or revoke them.
VITE_CONTRACT_ADDRESS=
VITE_CHAIN_ID=
