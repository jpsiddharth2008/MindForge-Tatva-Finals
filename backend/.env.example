# Copy to .env and fill in. Never commit .env.
BUCKET_NAME=
REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Issuer login. JWT_SECRET: 32+ random characters (node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
ADMIN_USERNAME=
# bcrypt hash, not the password:  echo "your password" | npm run hash-password --silent
ADMIN_PASSWORD_HASH=

# Browser origins allowed to call the API, comma separated, exact match. Required in production.
# Unset outside production means the local vite origins (5173, 4173).
CORS_ORIGINS=http://localhost:5173
# Requests per minute per IP on /api/hash and /api/anchor (default 30).
RATE_LIMIT_PER_MIN=
# Set to the number of reverse-proxy hops (1 behind one load balancer) so rate limits see real client IPs.
TRUST_PROXY=
PORT=5000
# Optional, for /api/health
RPC_URL=
CONTRACT_ADDRESS=
# Largest accepted upload in megabytes (default 10).
MAX_FILE_SIZE_MB=10

# S3 encryption at rest: AES256 (default) or aws:kms (then optionally S3_KMS_KEY_ID).
S3_SSE=AES256
S3_KMS_KEY_ID=
# Signed link lifetime in seconds, 1-300 (default and maximum 300).
PRESIGN_TTL_SECONDS=300

# MongoDB connection string (Atlas or local). Without it the server runs but issuance records are NOT saved.
MONGODB_URI=
# Recorded on each issued document
CHAIN_ID=
