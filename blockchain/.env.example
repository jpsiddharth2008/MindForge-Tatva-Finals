# Deployer / issuer signing key — testnet only, no 0x prefix needed either way
PRIVATE_KEY=

# RPC endpoints (defaults are public and rate-limited; use your own for reliability)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional — enables automatic source verification on the explorer
POLYGONSCAN_API_KEY=
ETHERSCAN_API_KEY=
